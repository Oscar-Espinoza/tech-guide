---
interface Column {
  title: string;
  subtitle: string;
  points: string[];
}
interface Props {
  title: string;
  description: string;
  left: Column;
  right: Column;
  centerLabel?: string;
}
const {
  title,
  description,
  left,
  right,
  centerLabel = 'trade-offs',
} = Astro.props;
const titleId = `diagram-title-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const descriptionId = `${titleId}-description`;
---

<figure class="diagram" data-pagefind-ignore>
  <svg
    viewBox="0 0 840 390"
    role="img"
    aria-labelledby={`${titleId} ${descriptionId}`}
  >
    <title id={titleId}>{title}</title>
    <desc id={descriptionId}>{description}</desc>
    <defs>
      <marker
        id={`${titleId}-arrow`}
        markerWidth="8"
        markerHeight="8"
        refX="7"
        refY="4"
        orient="auto"
      >
        <path d="M0 0 8 4 0 8Z" class="diagram-arrow"></path>
      </marker>
    </defs>
    <rect class="diagram-panel" x="20" y="28" width="315" height="330" rx="8"
    ></rect>
    <rect class="diagram-panel" x="505" y="28" width="315" height="330" rx="8"
    ></rect>
    <text class="diagram-heading" x="48" y="75">{left.title}</text>
    <text class="diagram-subtitle" x="48" y="105">{left.subtitle}</text>
    {
      left.points.map((point, index) => (
        <text class="diagram-label" x="66" y={155 + index * 48}>
          • {point}
        </text>
      ))
    }
    <text class="diagram-heading" x="533" y="75">{right.title}</text>
    <text class="diagram-subtitle" x="533" y="105">{right.subtitle}</text>
    {
      right.points.map((point, index) => (
        <text class="diagram-label" x="551" y={155 + index * 48}>
          • {point}
        </text>
      ))
    }
    <line
      class="diagram-connector"
      x1="350"
      y1="190"
      x2="485"
      y2="190"
      marker-end={`url(#${titleId}-arrow)`}></line>
    <line
      class="diagram-connector"
      x1="490"
      y1="220"
      x2="355"
      y2="220"
      marker-end={`url(#${titleId}-arrow)`}></line>
    <rect class="diagram-accent" x="365" y="173" width="110" height="64" rx="32"
    ></rect>
    <text class="diagram-center" x="420" y="211" text-anchor="middle"
      >{centerLabel}</text
    >
  </svg>
  <figcaption><strong>{title}.</strong> {description}</figcaption>
</figure>
