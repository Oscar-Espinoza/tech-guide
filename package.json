  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
